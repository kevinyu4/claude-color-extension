{
  "manifest_version": 3,
  "name": "Session Lights for Claude",
  "short_name": "Session Lights",
  "version": "1.0.0",
  "description": "Color-codes claude.ai chats and Claude Code sessions in the sidebar: red while running, green when finished but unread.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://claude.ai/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Session Lights",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/shared.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start"
    }
  ]
}
